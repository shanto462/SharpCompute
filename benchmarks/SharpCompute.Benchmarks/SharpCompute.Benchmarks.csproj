<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <!-- Precompiled shaders, so that the first-frame mode can time them against run-time compilation. -->
    <SharpComputePrecompileShaders Condition="'$(SharpComputePrecompileShaders)' == ''">true</SharpComputePrecompileShaders>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.16.0-preview.2" />
    <PackageReference Include="System.Numerics.Tensors" Version="11.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\SharpCompute\SharpCompute.csproj" />
    <!-- The gallery's shaders, for the first-frame measurement of a set of real shaders (CC BY-NC-SA: see its NOTICE.md). -->
    <ProjectReference Include="..\..\samples\SharpCompute.Samples.Shaders\SharpCompute.Samples.Shaders.csproj" />
    <ProjectReference Include="..\..\src\SharpCompute.SourceGenerators\SharpCompute.SourceGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
