<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The live gallery: every Gallery.All shader plus the live-only demos in Demos/ (original, MIT).
    Run with `dotnet run -project samples/SharpCompute.Samples.Viewer` from a desktop session.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <RootNamespace>SharpCompute.Samples.Viewer</RootNamespace>
    <AssemblyName>SharpCompute.Samples.Viewer</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="SharpCompute.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\SharpCompute\SharpCompute.csproj" />
    <ProjectReference Include="..\SharpCompute.Samples.Shaders\SharpCompute.Samples.Shaders.csproj" />
    <ProjectReference Include="..\..\src\SharpCompute.SourceGenerators\SharpCompute.SourceGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
