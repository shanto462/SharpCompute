<Project Sdk="Microsoft.NET.Sdk">
  <!--
    pipeline: a double-buffered GPU → CPU frame pipeline. The GPU renders frame N+1 (ForAsync) while
    the CPU post-processes frame N, compared with the synchronous render-then-process loop.
    Original SharpCompute sample (MIT). Usage: run the project with no arguments, or see Program.cs.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <RootNamespace>SharpCompute.Samples.Pipeline</RootNamespace>
    <AssemblyName>SharpCompute.Samples.Pipeline</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\SharpCompute\SharpCompute.csproj" />
    <!-- For the Mandelbrot shader and PngEncoder. -->
    <ProjectReference Include="..\SharpCompute.Samples.Shaders\SharpCompute.Samples.Shaders.csproj" />
    <ProjectReference Include="..\..\src\SharpCompute.SourceGenerators\SharpCompute.SourceGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
