<Project Sdk="Microsoft.NET.Sdk">
  <!--
    A tour of textures in shaders: the six samplers side by side, the eight pixel formats, and a
    ping-pong simulation between two read-write textures. Original SharpCompute sample (MIT).
    Run with scripts/demo-textures.sh from a desktop session (add the headless switch for PNGs only).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <RootNamespace>SharpCompute.Samples.Textures</RootNamespace>
    <AssemblyName>SharpCompute.Samples.Textures</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\SharpCompute\SharpCompute.csproj" />
    <!-- For the explorer's image option. -->
    <ProjectReference Include="..\..\src\SharpCompute.Imaging\SharpCompute.Imaging.csproj" />
    <!-- For PngEncoder only; the sample itself is MIT. -->
    <ProjectReference Include="..\SharpCompute.Samples.Shaders\SharpCompute.Samples.Shaders.csproj" />
    <ProjectReference Include="..\..\src\SharpCompute.SourceGenerators\SharpCompute.SourceGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
