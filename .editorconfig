# Formatting the code base already follows. Only whitespace, encoding and layout preferences: no
# diagnostic severities, so the build (warnings as errors) is unaffected.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{csproj,props,targets,slnx,xml,json,yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
csharp_style_namespace_declarations = file_scoped
csharp_new_line_before_open_brace = all
csharp_prefer_braces = true
dotnet_sort_system_directives_first = true
