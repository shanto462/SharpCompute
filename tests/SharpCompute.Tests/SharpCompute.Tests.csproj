<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- TestProgram.Main replaces the generated empty entry point: window tests launch this assembly to run on a main thread. -->
    <GenerateProgramFile>false</GenerateProgramFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\SharpCompute\SharpCompute.csproj" />
    <ProjectReference Include="..\..\samples\SharpCompute.Samples.Shaders\SharpCompute.Samples.Shaders.csproj" />
    <!-- Pulsewake is an Exe; its simulation and renderer types are tested directly. -->
    <ProjectReference Include="..\..\samples\SharpCompute.Samples.Shooter\SharpCompute.Samples.Shooter.csproj" />
    <!-- A class library, so a plain reference (the other Exe samples are loaded from their build output: see below). -->
    <ProjectReference Include="..\..\samples\SharpCompute.Samples.Audio\SharpCompute.Samples.Audio.csproj" />
    <ProjectReference Include="..\..\samples\SharpCompute.Samples.Platformer\SharpCompute.Samples.Platformer.csproj" />
    <!-- An Exe as well; the demo's rendering classes and its headless mode are tested directly. -->
    <ProjectReference Include="..\..\samples\SharpCompute.Samples.Textures\SharpCompute.Samples.Textures.csproj" />
    <!-- An Exe as well; its pages, canvas and headless mode are tested directly. -->
    <ProjectReference Include="..\..\samples\SharpCompute.Samples.ComputeLab\SharpCompute.Samples.ComputeLab.csproj" />
    <ProjectReference Include="..\..\src\SharpCompute.SourceGenerators\SharpCompute.SourceGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup>
    <!--
      Build-only references: SampleAssembly and ViewerAssembly load these Exe samples from their own
      output folders, so nothing is referenced or copied here. Without them, `dotnet test` builds only
      the test projects and what they reference, and every test of these samples skips as "not built".
      Private="false" matters: without it each sample's apphost, deps.json and runtimeconfig.json are
      still copied into the test output, next to no dll.
    -->
    <ProjectReference Include="..\..\samples\SharpCompute.Samples.ImageProcessing\SharpCompute.Samples.ImageProcessing.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\..\samples\SharpCompute.Samples.Paint\SharpCompute.Samples.Paint.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\..\samples\SharpCompute.Samples.Viewer\SharpCompute.Samples.Viewer.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>
</Project>
